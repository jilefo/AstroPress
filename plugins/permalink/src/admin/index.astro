---
import AdminLayout from "../../../../apps/admin/src/layouts/AdminLayout.astro";
import { loadSettings, saveSettings } from "../lib/settings";

const user = Astro.locals.user;
const db = Astro.locals.db;
if (!user) return Astro.redirect("/login");

let saved = false;
if (Astro.request.method === "POST") {
  try {
    const body = await Astro.request.json();
    await saveSettings(db, { enabled: !!body.enabled, redirectOld: !!body.redirectOld });
    saved = true;
  } catch {
    /* ignore */
  }
}

const settings = await loadSettings(db);
---
<AdminLayout title="固定链接美化">
  <style is:global>
    .pm-card { background:#fff;border:1px solid #c3c4c7;border-radius:4px;padding:20px;max-width:640px; }
    .pm-card h2 { margin:0 0 12px;font-size:16px; }
    .pm-row { display:flex;align-items:center;gap:10px;margin:12px 0; }
    .pm-note { color:#646970;font-size:13px;line-height:1.6;margin-top:10px; }
    .pm-ok { color:#00a32a;font-weight:600;margin-top:10px; }
    .btn { background:#2271b1;color:#fff;border:0;border-radius:3px;padding:6px 14px;cursor:pointer;font-size:13px; }
  </style>

  <div class="pm-card">
    <h2>固定链接美化</h2>
    <div class="pm-note">
      启用后，已发布文章可直接通过 <code>&#123;slug&#125;</code> 访问，无需 <code>/blog/</code> 前缀；
      全站文章出站链接（列表、sitemap、RSS、相关文章等）同步使用新形态。<br/>
      旧 <code>/blog/&#123;slug&#125;</code> 链接可自动 301 迁移到 <code>/&#123;slug&#125;</code>，避免重复内容，利于 SEO。
    </div>

    <form id="pmForm" method="post" style="margin-top:16px">
      <label class="pm-row">
        <input type="checkbox" id="pmEnabled" name="enabled" checked={settings.enabled} />
        <span>启用 /&#123;slug&#125; 直达文章</span>
      </label>
      <label class="pm-row">
        <input type="checkbox" id="pmRedirectOld" name="redirectOld" checked={settings.redirectOld} />
        <span>旧 /blog/&#123;slug&#125; 链接 301 迁移到 /&#123;slug&#125;</span>
      </label>
      <button type="submit" class="btn">保存设置</button>
    </form>
    <div id="pmStatus" class="pm-ok" style="display:none">已保存 ✓</div>
  </div>

  <script>
    (function () {
      var form = document.getElementById("pmForm");
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        fetch(location.pathname, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            enabled: document.getElementById("pmEnabled").checked,
            redirectOld: document.getElementById("pmRedirectOld").checked,
          }),
        }).then(function () {
          var s = document.getElementById("pmStatus");
          s.style.display = "block";
          setTimeout(function () { s.style.display = "none"; }, 2000);
        });
      });
    })();
  </script>
</AdminLayout>
