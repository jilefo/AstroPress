---
/**
 * /admin-ext/config-io — 配置导入导出
 *
 * 导出：勾选 section 后直接下载 JSON（Content-Disposition attachment）。
 * 导入：上传 JSON，选 merge/replace，展示 inserted/updated/skipped/failed 摘要与错误明细。
 */
import AdminLayout from "../../../../apps/admin/src/layouts/AdminLayout.astro";
if (!Astro.locals.user || !Astro.locals.db) return Astro.redirect("/login");
---
<AdminLayout title="配置导入导出">
    <style is:global>
      * { box-sizing: border-box; }
      .wrap { max-width: 820px; margin: 0 auto; padding: 0 16px; display: grid; gap: 20px; }
      .card { background: #fff; border: 1px solid #c3c4c7; border-radius: 4px; padding: 20px; }
      h1 { font-size: 20px; margin: 0 0 6px; }
      h2 { font-size: 15px; margin: 0 0 12px; }
      button { background: #2271b1; color: #fff; border: 0; border-radius: 3px; padding: 8px 18px; cursor: pointer; font-size: 13px; }
      button:hover { background: #135e96; }
      .msg { font-size: 13px; margin-top: 10px; min-height: 18px; }
      .ok { color: #00a32a; }
      .err { color: #b32d2e; }
      .hint { font-size: 12px; color: #646970; margin-top: 6px; line-height: 1.7; }
      .check { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; margin: 10px 0; }
      .check label { font-weight: normal; margin: 0; }
      .check small { color: #646970; display: block; margin-top: 2px; }
      input[type="file"] { font-size: 13px; margin: 8px 0; }
      .modes { display: flex; gap: 20px; margin: 10px 0; font-size: 13px; }
      .modes label { display: flex; align-items: center; gap: 6px; font-weight: normal; margin: 0; }
      .warn { background: #fcf0c8; border: 1px solid #d9c471; border-radius: 4px; padding: 10px 12px; font-size: 12px; color: #6d5400; margin: 12px 0; }
      .summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 14px 0; }
      .stat { background: #f6f7f9; border: 1px solid #e2e4e7; border-radius: 6px; padding: 12px; text-align: center; }
      .stat b { display: block; font-size: 22px; }
      .stat span { font-size: 12px; color: #646970; }
      .stat.failed b { color: #b32d2e; }
      .errors { font-size: 12px; color: #b32d2e; max-height: 220px; overflow: auto; border: 1px solid #f0c4c5; border-radius: 4px; padding: 8px 12px; background: #fef7f7; margin-top: 8px; }
      .errors div { padding: 2px 0; }
      code { background: #f0f0f1; padding: 1px 5px; border-radius: 3px; font-size: 12px; }
    </style>

    <div class="wrap">
      <!-- 导出 -->
      <section class="card">
        <h1>配置导入导出</h1>
        <h2 style="margin-top:16px">导出</h2>
        <div class="check">
          <input type="checkbox" id="ex-settings" class="ex-sec" checked />
          <label for="ex-settings">站点设置<small><code>blogname</code>、<code>siteurl</code> 等 14 个白名单键</small></label>
        </div>
        <div class="check">
          <input type="checkbox" id="ex-plugins" class="ex-sec" checked />
          <label for="ex-plugins">插件设置<small><code>astropress_%</code> 前缀选项，自动排除 setup 标记与含 secret/key/password/salt 的敏感键</small></label>
        </div>
        <div class="check">
          <input type="checkbox" id="ex-themes" class="ex-sec" checked />
          <label for="ex-themes">主题配置<small><code>astropress_themes</code>、活动主题、主题 tokens、模板四键</small></label>
        </div>
        <div class="check">
          <input type="checkbox" id="ex-content" class="ex-sec" checked />
          <label for="ex-content">内容数据<small>文章/页面、meta、分类法与关系共五表（不含用户与会话表）；超 5 万行拒绝导出</small></label>
        </div>
        <button id="exportBtn">下载 JSON</button>
        <div class="msg" id="exMsg" class="err"></div>
      </section>

      <!-- 导入 -->
      <section class="card">
        <h2>导入</h2>
        <input type="file" id="imFile" accept="application/json,.json" />

        <div class="modes">
          <label><input type="radio" name="mode" value="merge" checked /> merge（合并：按主键 upsert，不删除缺失项）</label>
          <label><input type="radio" name="mode" value="replace" /> replace（替换：清空对应范围后写入）</label>
        </div>

        <div class="check"><input type="checkbox" id="im-settings" class="im-sec" checked /><label for="im-settings">站点设置</label></div>
        <div class="check"><input type="checkbox" id="im-plugins" class="im-sec" checked /><label for="im-plugins">插件设置</label></div>
        <div class="check"><input type="checkbox" id="im-themes" class="im-sec" checked /><label for="im-themes">主题配置</label></div>
        <div class="check"><input type="checkbox" id="im-content" class="im-sec" checked /><label for="im-content">内容数据</label></div>

        <div class="warn" id="warnBox" hidden>
          replace 模式将清空所选范围后再写入：选项仅删除对应 section 白名单范围内的键（
          <code>astropress_setup_complete</code> 永不删除）；内容数据会在一个事务中清空五张内容表后批量插入，失败将整体回滚。
        </div>

        <button id="importBtn">开始导入</button>
        <div class="msg" id="imMsg"></div>
        <div class="summary" id="imSummary" hidden>
          <div class="stat"><b id="st-inserted">0</b><span>inserted</span></div>
          <div class="stat"><b id="st-updated">0</b><span>updated</span></div>
          <div class="stat"><b id="st-skipped">0</b><span>skipped</span></div>
          <div class="stat failed"><b id="st-failed">0</b><span>failed</span></div>
        </div>
        <div class="errors" id="imErrors" hidden></div>
      </section>
    </div>

    <script>
      var SECTION_IDS = { settings: "settings", plugins: "plugins", themes: "themes", content: "content" };
      function checkedSections(cls) {
        return Array.prototype.slice
          .call(document.querySelectorAll("." + cls))
          .filter(function (cb) { return cb.checked; })
          .map(function (cb) { return cb.id.split("-")[1]; });
      }

      document.getElementById("exportBtn").addEventListener("click", function () {
        var secs = checkedSections("ex-sec");
        var msg = document.getElementById("exMsg");
        if (!secs.length) { msg.textContent = "请至少选择一个导出部分"; return; }
        msg.textContent = "";
        // GET 下载：接口带 Content-Disposition: attachment，浏览器直接保存
        window.location.href = "/admin-ext/api/config-io/export?sections=" + encodeURIComponent(secs.join(","));
      });

      var modeRadios = document.querySelectorAll('input[name="mode"]');
      function refreshWarn() {
        var replace = Array.prototype.some.call(modeRadios, function (r) { return r.checked && r.value === "replace"; });
        document.getElementById("warnBox").hidden = !replace;
      }
      modeRadios.forEach(function (r) { r.addEventListener("change", refreshWarn); });

      document.getElementById("importBtn").addEventListener("click", async function () {
        var fileInput = document.getElementById("imFile");
        var msg = document.getElementById("imMsg");
        var summary = document.getElementById("imSummary");
        var errorsBox = document.getElementById("imErrors");
        msg.className = "msg"; msg.textContent = "";
        summary.hidden = true; errorsBox.hidden = true; errorsBox.innerHTML = "";

        var file = fileInput.files && fileInput.files[0];
        if (!file) { msg.textContent = "请选择要导入的 JSON 文件"; msg.className = "msg err"; return; }
        var secs = checkedSections("im-sec");
        if (!secs.length) { msg.textContent = "请至少选择一个导入部分"; msg.className = "msg err"; return; }
        var mode = document.querySelector('input[name="mode"]:checked').value;

        var fd = new FormData();
        fd.append("file", file);
        fd.append("mode", mode);
        fd.append("sections", secs.join(","));

        var btn = document.getElementById("importBtn");
        btn.disabled = true; btn.textContent = "导入中…";
        try {
          var r = await fetch("/admin-ext/api/config-io/import", { method: "POST", credentials: "same-origin", body: fd });
          var d = await r.json();
          if (!r.ok) { msg.textContent = d.error || "导入失败"; msg.className = "msg err"; return; }
          var s = d.summary || { inserted: 0, updated: 0, skipped: 0, failed: 0 };
          document.getElementById("st-inserted").textContent = s.inserted;
          document.getElementById("st-updated").textContent = s.updated;
          document.getElementById("st-skipped").textContent = s.skipped;
          document.getElementById("st-failed").textContent = s.failed;
          summary.hidden = false;
          msg.className = "msg ok";
          msg.textContent = "导入完成（" + (d.importedSections || []).join(", ") + "，" + d.mode + "）";
          if (d.errors && d.errors.length) {
            errorsBox.innerHTML = d.errors.map(function (e) { // ap-audit-ok: 文本上下文，& 与 < 已转义，未拼入任何属性
              return "<div>" + String(e).replace(/&/g, "&amp;").replace(/</g, "&lt;") + "</div>";
            }).join("");
            errorsBox.hidden = false;
          }
        } catch (e) {
          msg.textContent = "请求失败：" + e;
          msg.className = "msg err";
        } finally {
          btn.disabled = false; btn.textContent = "开始导入";
        }
      });
    </script>
</AdminLayout>
