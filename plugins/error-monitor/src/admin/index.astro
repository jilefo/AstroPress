---
/**
 * /admin-ext/404-monitor — 404 监控设置与记录页
 */
import AdminLayout from "../../../../apps/admin/src/layouts/AdminLayout.astro";
if (!Astro.locals.user || !Astro.locals.db) return Astro.redirect("/login");
---
<AdminLayout title="404 监控">
    <style is:global>
      * { box-sizing: border-box; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 0 16px; }
      .card { background: #fff; border: 1px solid #c3c4c7; border-radius: 4px; padding: 20px; margin-bottom: 20px; }
      h1 { font-size: 20px; margin: 0 0 16px; }
      h2 { font-size: 15px; margin: 0 0 12px; }
      label { display: block; font-size: 13px; font-weight: 600; margin: 16px 0 4px; }
      textarea { width: 100%; font-size: 13px; padding: 6px 8px; border: 1px solid #8c8f94; border-radius: 3px; font-family: Consolas, Monaco, monospace; resize: vertical; }
      button { background: #2271b1; color: #fff; border: 0; border-radius: 3px; padding: 8px 16px; cursor: pointer; font-size: 13px; }
      button:hover { background: #135e96; }
      .btn-secondary { background: #f6f7f7; color: #2c3338; border: 1px solid #c3c4c7; }
      .btn-secondary:hover { background: #eceeef; }
      .btn-danger { background: #d63638; }
      .btn-danger:hover { background: #b32d2e; }
      .btn-small { padding: 4px 10px; margin: 0; }
      .msg { font-size: 13px; margin-top: 10px; min-height: 18px; }
      .ok { color: #00a32a; }
      .err { color: #b32d2e; }
      .hint { font-size: 12px; color: #646970; margin-top: 4px; }
      .check { display: flex; align-items: center; gap: 6px; font-size: 13px; margin: 10px 0; }
      .check label { margin: 0; font-weight: 400; }
      .list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; gap: 12px; }
      .list-head h2 { margin: 0; }
      table { width: 100%; border-collapse: collapse; font-size: 13px; }
      th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
      th { background: #f6f7f7; font-weight: 600; white-space: nowrap; }
      td.col-path { word-break: break-all; font-family: Consolas, Monaco, monospace; max-width: 360px; }
      td.col-hits { text-align: right; white-space: nowrap; }
      td.col-time { white-space: nowrap; color: #646970; }
      td.col-ref { word-break: break-all; color: #646970; max-width: 220px; }
      td.col-op { white-space: nowrap; }
      .empty { padding: 24px; text-align: center; color: #646970; font-size: 13px; }
    </style>

    <div class="wrap">
      <div class="card">
        <h1>404 监控</h1>

        <div class="check">
          <input type="checkbox" id="enabled" checked />
          <label for="enabled">启用 404 记录</label>
        </div>
        <div class="check">
          <input type="checkbox" id="logAssets" />
          <label for="logAssets">记录静态资源 404（默认关闭，带 .css/.js/.png 等扩展名的请求不记录）</label>
        </div>

        <label for="ignores">忽略规则</label>
        <textarea id="ignores" rows="5" placeholder="/favicon.ico&#10;/wp-content/"></textarea>
        <div class="hint">每行一条，按「子串包含」匹配完整路径（含查询串）；命中即不记录。最多 50 条，每条最长 200 字符。</div>

        <button id="save">保存设置</button>
        <div class="msg" id="msg"></div>
      </div>

      <div class="card">
        <div class="list-head">
          <h2>404 记录（最多显示 200 条）</h2>
          <button type="button" class="btn-danger" id="clearAll">清空全部记录</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>路径</th>
              <th style="text-align:right">次数</th>
              <th>首次时间</th>
              <th>最近时间</th>
              <th>来源 Referer</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody id="logBody"></tbody>
        </table>
        <div class="empty" id="emptyTip" style="display:none">暂无 404 记录</div>
      </div>
    </div>

    <script>
      (function () {
        var msgEl = document.getElementById("msg");
        var bodyEl = document.getElementById("logBody");
        var emptyEl = document.getElementById("emptyTip");

        function flash(text, ok) {
          msgEl.className = "msg " + (ok ? "ok" : "err");
          msgEl.textContent = text;
          setTimeout(function () { msgEl.textContent = ""; }, 3000);
        }

        function fmtTime(ts) {
          var n = Number(ts);
          if (!Number.isFinite(n) || n <= 0) return "—";
          return new Date(n).toLocaleString();
        }

        function cell(tr, text, cls) {
          var td = document.createElement("td");
          td.textContent = text;
          if (cls) td.setAttribute("class", cls);
          tr.appendChild(td);
          return td;
        }

        function renderList(items) {
          while (bodyEl.firstChild) bodyEl.removeChild(bodyEl.firstChild);
          if (!items || items.length === 0) {
            emptyEl.style.display = "block";
            return;
          }
          emptyEl.style.display = "none";

          items.forEach(function (item) {
            var tr = document.createElement("tr");

            cell(tr, String(item.path ?? ""), "col-path");
            cell(tr, String(item.hits ?? 0), "col-hits");
            cell(tr, fmtTime(item.first_seen), "col-time");
            cell(tr, fmtTime(item.last_seen), "col-time");
            cell(tr, String(item.referer || "—"), item.referer ? "col-ref" : "col-ref");

            var tdOp = document.createElement("td");
            tdOp.setAttribute("class", "col-op");
            var delBtn = document.createElement("button");
            delBtn.setAttribute("type", "button");
            delBtn.setAttribute("class", "btn-danger btn-small");
            delBtn.textContent = "删除";
            delBtn.addEventListener("click", function () {
              if (!window.confirm("确定删除这条 404 记录吗？\n" + item.path)) return;
              deleteOne(String(item.path ?? ""));
            });
            tdOp.appendChild(delBtn);
            tr.appendChild(tdOp);

            bodyEl.appendChild(tr);
          });
        }

        async function fetchList() {
          var r = await fetch("/admin-ext/api/404/list");
          if (!r.ok) {
            flash("加载记录失败", false);
            return;
          }
          var d = await r.json();
          renderList(d.items);
        }

        async function fillSettings() {
          var r = await fetch("/admin-ext/api/404/settings");
          if (!r.ok) return;
          var s = await r.json();
          document.getElementById("enabled").checked = !!s.enabled;
          document.getElementById("logAssets").checked = !!s.logAssets;
          document.getElementById("ignores").value = Array.isArray(s.ignores) ? s.ignores.join("\n") : "";
        }

        async function postAction(payload) {
          var r = await fetch("/admin-ext/api/404/actions", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          var d = await r.json().catch(function () { return {}; });
          if (!r.ok) {
            flash(d.error || "操作失败", false);
            return false;
          }
          return true;
        }

        async function deleteOne(path) {
          var ok = await postAction({ confirm: true, action: "delete", path: path });
          if (ok) {
            flash("已删除。", true);
            fetchList();
          }
        }

        document.getElementById("clearAll").addEventListener("click", async function () {
          if (!window.confirm("确定清空全部 404 记录吗？此操作不可恢复。")) return;
          var ok = await postAction({ confirm: true, action: "clear" });
          if (ok) {
            flash("已清空全部记录。", true);
            fetchList();
          }
        });

        document.getElementById("save").addEventListener("click", async function () {
          var ignores = document.getElementById("ignores").value
            .split("\n")
            .map(function (s) { return s.trim(); })
            .filter(function (s) { return s.length > 0; })
            .slice(0, 50);
          var payload = {
            enabled: document.getElementById("enabled").checked,
            logAssets: document.getElementById("logAssets").checked,
            ignores: ignores,
          };
          var r = await fetch("/admin-ext/api/404/settings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          var d = await r.json().catch(function () { return {}; });
          if (r.ok) flash("已保存。", true);
          else flash(d.error || "保存失败", false);
        });

        // 页面加载并行拉取列表与设置
        Promise.all([fetchList(), fillSettings()]);
      })();
    </script>
</AdminLayout>
