                         "@astropress/plugin-asset-cache":  "workspace:*",
                         "@astropress/plugin-sitemap":  "workspace:*",
                         "@astropress/plugin-static-html":  "workspace:*",
                         "@astropress/plugin-error-monitor":  "workspace:*",
                         "@astropress/plugin-cache-warmer":  "workspace:*"
                     },
    "devDependencies":  {
                            "astro":  "^4.0.0",
                            "typescript":  "^5.4.0",
                            "@cloudflare/workers-types":  "^4.0.0"
                        }
}
