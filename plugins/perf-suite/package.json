{
    "name":  "@astropress/plugin-perf-suite",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "合并套件：页面缓存 · 图片懒加载 · HTML优化 · 静态资源缓存 · 网站地图 · 静态HTML生成 · 404监控 · 缓存预热",
