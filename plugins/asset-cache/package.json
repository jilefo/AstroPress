{
  "name": "@astropress/plugin-asset-cache",
  "version": "0.1.0",
  "description": "静态资源缓存头：为 /_astro、/media 及常见静态扩展名响应设置 Cache-Control（强缓存），支持三档 max-age、强制覆盖与自定义扩展名映射",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./integration.admin": "./src/integration.admin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astropress/core": "workspace:*",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "astro": "^4.0.0",
    "typescript": "^5.4.0",
    "@cloudflare/workers-types": "^4.0.0"
  }
}
