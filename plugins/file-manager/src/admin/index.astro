            <button type="button" class="fe-winbtn" id="feMax" title="最大化" aria-label="最大化">⛶</button>
            <button type="button" class="fm-modal-x" id="editorClose" aria-label="关闭">×</button>
          </div>
        </div>
        <!-- 工具栏（对标宝塔：保存/全部保存/刷新/搜索/替换/跳转行/字号/主题/快捷键） -->
        <div class="fe-toolbar" id="feToolbar">
          <button type="button" class="fe-tbtn" id="feSave" title="保存当前文件 (Ctrl+S)">💾 保存</button>
          <button type="button" class="fe-tbtn" id="feSaveAll" title="保存所有已修改的标签页">全部保存</button>
          <button type="button" class="fe-tbtn" id="feReload" title="放弃修改并重新从磁盘读取">⟳ 刷新</button>
          <span class="fe-sep"></span>
          <button type="button" class="fe-tbtn" id="feUndo" title="撤销 (Ctrl+Z)">↶ 撤销</button>
          <button type="button" class="fe-tbtn" id="feRedo" title="重做 (Ctrl+Y)">↷ 重做</button>
          <span class="fe-sep"></span>
          <button type="button" class="fe-tbtn" id="feFind" title="查找 / 替换 (Ctrl+F)">🔍 搜索替换</button>
          <button type="button" class="fe-tbtn" id="feGoto" title="转到指定行 (Ctrl+G)">⤓ 跳转行</button>
          <span class="fe-sep"></span>
          <button type="button" class="fe-tbtn" id="feFontDec" title="减小字号">A−</button>
          <button type="button" class="fe-tbtn" id="feFontInc" title="增大字号">A+</button>
          <button type="button" class="fe-tbtn on" id="feWrap" title="切换自动换行">自动换行</button>
          <span class="fe-sep"></span>
          <button type="button" class="fe-tbtn" id="feTheme" title="切换深色主题">🌙 深色</button>
          <button type="button" class="fe-tbtn" id="feKeys" title="快捷键一览">⌨ 快捷键</button>
          <span class="fe-lang" id="feLang">plain text</span>
        </div>
        <!-- 快捷键说明浮层 -->
        <div class="fe-keys-pop" id="feKeysPop">
          <div class="fe-keys-title">快捷键</div>
          <div class="fe-keys-grid">
            <span>Ctrl+S</span><span>保存当前文件</span>
            <span>Ctrl+F</span><span>搜索 / 替换</span>
            <span>Ctrl+G</span><span>跳转到行</span>
            <span>Ctrl+Z / Ctrl+Y</span><span>撤销 / 重做</span>
            <span>Tab / Shift+Tab</span><span>缩进 / 反缩进</span>
            <span>Esc</span><span>关闭搜索栏</span>
          </div>
        </div>
        <!-- 标签页栏 -->
        <div class="fe-tabs" id="feTabs"></div>
        <div class="fm-modal-body fe-body">
          <!-- 左侧：当前目录文件列表 -->
          <div class="fe-side" id="feSide">
            <div class="fe-side-head">
              <span title="文件树">📁</span>
              <span class="fe-side-up" id="feSideUp" title="上一级">⬆</span>
              <span class="fe-side-dir" id="feSideDir" title="当前目录">/</span>
              <span class="fe-side-refresh" id="feSideRefresh" title="刷新列表">⟳</span>
            </div>
            <div class="fe-side-list" id="feSideList"><div class="fe-side-empty">加载中…</div></div>
          </div>
          <!-- 右侧：编辑区 -->
          <div class="fe-main">
            <div class="fe-findbar" id="feFindBar">
              <input type="text" id="feFindInput" placeholder="查找内容" />
              <button type="button" class="fe-tbtn" id="feFindPrev">上一个</button>
              <button type="button" class="fe-tbtn" id="feFindNext">下一个</button>
              <span class="fe-count" id="feFindCount"></span>
              <input type="text" id="feReplaceInput" placeholder="替换为" />
              <button type="button" class="fe-tbtn" id="feReplaceOne">替换</button>
              <button type="button" class="fe-tbtn" id="feReplaceAll">全部替换</button>
              <button type="button" class="fe-tbtn" id="feFindClose">✕</button>
            </div>
            <div class="fm-editor-wrap readonly" id="feWrapBox">
              <div class="fm-cm-host" id="cmHost"></div>
            </div>
          </div>
        </div>
        <!-- 状态栏（对标宝塔：文件位置/LF/行列/制表符/编码/语言） -->
        <div class="fe-statusbar">
          <span class="fe-dirty" id="feDirty">● 未保存</span>
          <span class="fe-loc" id="feLoc" title="文件位置">文件位置：-</span>
          <span>LF</span>
          <span id="fePos">行 1，列 1</span>
          <span id="feSel"></span>
          <span class="fe-right">制表符：4 · <span id="feChars">0 字符</span> · <span id="feBytes">0 字节</span> · UTF-8 · <span id="feLangSb">plain text</span></span>
        </div>
        <div class="fm-modal-foot">
          <button type="button" class="fm-btn" id="editorCancel">关闭</button>
          <button type="button" class="fm-btn" id="editorToEdit" style="display:none">✏️ 切换到编辑</button>
          <button type="button" class="fm-btn primary" id="editorSave">保存</button>
        </div>
      </div>
    </div>

    <!-- 编辑器最小化后的恢复条（保留全部标签状态） -->
    <div class="fe-mini" id="feMiniBar" title="点击恢复编辑器">
      <span class="fe-mini-ico">📝</span>
      <span class="fe-mini-txt" id="feMiniText">文件编辑器</span>
      <button type="button" class="fe-mini-x" id="feMiniClose" title="关闭编辑器" aria-label="关闭">×</button>
    </div>

    <!-- 复制/移动目录选择弹窗 -->
    <div class="fm-modal-mask" id="transferMask">
      <div class="fm-modal" role="dialog" aria-modal="true" aria-label="选择目标目录">
        <div class="fm-modal-head">
          <div><strong id="transferTitle">复制到…</strong></div>
          <button type="button" class="fm-modal-x" id="transferClose" aria-label="关闭">×</button>
        </div>
        <div class="fm-modal-body">
          <ul class="fm-dirs" id="dirsList"></ul>
          <input type="text" class="fm-dest-input" id="destInput" placeholder="目标目录相对路径（留空 = 站点根）" />
          <p class="fm-modal-hint" id="transferHint"></p>
        </div>
        <div class="fm-modal-foot">
          <button type="button" class="fm-btn" id="transferCancel">取消</button>
          <button type="button" class="fm-btn primary" id="transferOk">确定</button>
        </div>
