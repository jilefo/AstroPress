---
/**
 * /admin-ext/files — 网站文件管理器（Explorer 风格）
 */
import AdminLayout from "../../../../apps/admin/src/layouts/AdminLayout.astro";
if (!Astro.locals.user || !Astro.locals.db) return Astro.redirect("/login");
// 页面无 Last-Modified/ETag，浏览器可能启发式缓存旧 HTML/旧脚本；
// 显式 no-store 保证每次加载都是最新代码（CodeMirror 6 编辑器脚本随页更新）。
Astro.response.headers.set("Cache-Control", "no-store");
---
<AdminLayout title="文件管理">
    <style is:global>
      * { box-sizing: border-box; }
      .fm-wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; display: grid; gap: 16px; }
      .fm-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 18px 22px 20px; box-shadow: 0 1px 3px rgba(15,23,42,.06); }
      .fm-card h1 { font-size: 18px; margin: 0 0 4px; font-weight: 600; color: #111827; }
      .fm-muted { color: #6b7280; font-size: 12px; }
      .fm-muted code { background: #f3f4f6; border-radius: 4px; padding: 1px 5px; color: #4b5563; }
      /* 工具栏：无边框分组 + 幽灵按钮 */
      .fm-toolbar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 14px; padding: 8px 10px; background: #f9fafb; border: 1px solid #eef0f2; border-radius: 10px; }
      .fm-btn { background: #fff; color: #374151; border: 1px solid #e5e7eb; border-radius: 7px; padding: 5px 12px; cursor: pointer; font-size: 13px; line-height: 1.5; transition: background .12s, border-color .12s, color .12s; }
      .fm-btn:hover:not(:disabled) { background: #f3f4f6; border-color: #d1d5db; color: #111827; }
      .fm-btn:disabled { opacity: .4; cursor: default; }
      .fm-btn.primary { background: #4f46e5; border-color: #4f46e5; color: #fff; }
      .fm-btn.primary:hover:not(:disabled) { background: #4338ca; border-color: #4338ca; color: #fff; }
      .fm-btn.danger { background: #fff; border-color: #fecaca; color: #dc2626; }
      .fm-btn.danger:hover:not(:disabled) { background: #fef2f2; border-color: #fca5a5; color: #b91c1c; }
      /* 面包屑：胶囊式 */
      .fm-crumbs { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; font-size: 13px; margin-top: 12px; padding: 7px 12px; border: 1px solid #eef0f2; border-radius: 10px; background: #f9fafb; }
      .fm-crumbs a { color: #4f46e5; text-decoration: none; cursor: pointer; padding: 2px 7px; border-radius: 5px; transition: background .12s; }
      .fm-crumbs a:hover { text-decoration: none; background: #eef2ff; }
      .fm-crumbs .sep { color: #d1d5db; }
      /* 文件表格：去竖线、行 hover 圆角 */
      table.fm-grid { border-collapse: collapse; width: 100%; font-size: 13px; margin-top: 12px; }
      table.fm-grid th, table.fm-grid td { border: 0; border-bottom: 1px solid #f0f1f4; padding: 8px 10px; text-align: left; vertical-align: middle; }
      table.fm-grid th { background: transparent; font-weight: 600; color: #6b7280; font-size: 12px; border-bottom: 1px solid #e5e7eb; }
      table.fm-grid tbody tr { transition: background .1s; }
      table.fm-grid tbody tr:hover { background: #f6f7fb; }
      table.fm-grid tbody tr.selected { background: #eef2ff; }
      table.fm-grid tbody tr.is-protected { color: #9ca3af; background: #fafbfc; }
      .fm-name { display: flex; align-items: center; gap: 7px; cursor: default; user-select: none; }
      .fm-name svg { flex-shrink: 0; opacity: .75; }
      .fm-empty { color: #646970; text-align: center; padding: 24px; }
      .fm-msg { margin-top: 10px; font-size: 13px; min-height: 18px; }
      .fm-ok { color: #00a32a; }
      .fm-err { color: #b32d2e; }
      .fm-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
      /* —— 编辑器弹窗：现代化重构 —— */
      /* z-index 必须高于后台外壳：AdminLayout 顶栏 99999、侧栏 9999，否则弹层左/上部分被外壳遮挡（侧栏被压成窄条） */
      .fm-modal-mask { position: fixed; inset: 0; background: rgba(15,18,30,.5); backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center; z-index: 100000; }
      .fm-modal-mask.is-open { display: flex; }
      .fm-modal { background: #fff; border-radius: 12px; width: min(860px, 92vw); max-height: 88vh; display: flex; flex-direction: column; box-shadow: 0 24px 64px rgba(15,23,42,.3); overflow: hidden; }
      .fm-modal.wide { width: min(1080px, 95vw); max-height: 92vh; }
      .fm-modal-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid #f0f1f4; background: #fafbfc; }
      .fm-modal-head strong { font-size: 14px; font-weight: 600; color: #111827; }
      .fm-modal-head .fm-path { font-family: 'Cascadia Code', Consolas, monospace; font-size: 12px; color: #9ca3af; margin-left: 10px; word-break: break-all; }
      .fm-modal-x { border: 0; background: none; font-size: 20px; cursor: pointer; color: #9ca3af; line-height: 1; border-radius: 6px; padding: 2px 8px; }
      .fm-modal-x:hover { background: #f3f4f6; color: #374151; }
      .fm-modal-body { padding: 0; overflow: auto; flex: 1; display: flex; flex-direction: column; }
      .fm-modal-foot { padding: 10px 18px; border-top: 1px solid #f0f1f4; display: flex; justify-content: flex-end; gap: 8px; background: #fafbfc; }
      .fm-cm-host { flex: 1; min-height: 48vh; height: 48vh; }
      .fm-cm-host .cm-editor { height: 100%; }
      .fm-editor-wrap { display: flex; border: 0; border-radius: 0; overflow: hidden; background: #fff; flex: 1; transition: background .2s; }
      .fm-editor-wrap.readonly { background: #fff; }
      .fm-editor-wrap.dark { background: #1e1e1e; }
      /* —— 深色模式：整个编辑器弹窗一起变深（VS Code 风格） —— */
      .fm-modal.dark { background: #252526; }
      .fm-modal.dark .fm-modal-head { background: #2d2d2d; border-bottom-color: #3e3e42; }
      .fm-modal.dark .fm-modal-head strong { color: #e7e7e7; }
      .fm-modal.dark .fm-modal-head .fm-path { color: #9d9d9d; }
      .fm-modal.dark .fm-modal-x { color: #9d9d9d; }
      .fm-modal.dark .fm-modal-x:hover { background: #3e3e42; color: #fff; }
      .fm-modal.dark .fe-toolbar { background: #252526; border-bottom-color: #3e3e42; }
      .fm-modal.dark .fe-tbtn { color: #cccccc; }
      .fm-modal.dark .fe-tbtn:hover:not(:disabled) { background: #37373d; color: #fff; }
      .fm-modal.dark .fe-tbtn.on { background: #264f78; color: #fff; border-color: transparent; }
      .fm-modal.dark .fe-sep { background: #3e3e42; }
      .fm-modal.dark .fe-lang { background: #3c3c3c; color: #9d9d9d; }
      .fm-modal.dark .fe-findbar { background: #2d2d2d; border-bottom-color: #3e3e42; }
      .fm-modal.dark .fe-findbar input { background: #1e1e1e; border-color: #3e3e42; color: #d4d4d4; }
      .fm-modal.dark .fe-findbar .fe-count { color: #9d9d9d; }
      .fm-modal.dark .fe-statusbar { background: #252526; border-top-color: #3e3e42; color: #9d9d9d; }
      .fm-modal.dark .fm-modal-foot { background: #2d2d2d; border-top-color: #3e3e42; }
      .fm-modal.dark .fm-modal-foot .fm-btn { background: #3c3c3c; border-color: #4a4a4a; color: #e0e0e0; }
      .fm-modal.dark .fm-modal-foot .fm-btn:hover:not(:disabled) { background: #4a4a4a; border-color: #5a5a5a; color: #fff; }
      .fm-modal.dark .fm-modal-foot .fm-btn.primary { background: #0e639c; border-color: #0e639c; color: #fff; }
      .fm-modal.dark .fm-modal-foot .fm-btn.primary:hover:not(:disabled) { background: #1177bb; border-color: #1177bb; }
      .fm-cm-loading { padding: 16px 18px; color: #9ca3af; font-size: 13px; font-family: 'Cascadia Code', Consolas, monospace; }
      /* 宝塔风格：右键菜单 */
      .fm-ctx { position: fixed; z-index: 100001; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 8px 28px rgba(15,18,30,.14); display: none; min-width: 168px; font-size: 13px; padding: 4px; }
      .fm-ctx.show { display: block; }
      .fm-ctx .fm-ctx-item { display: flex; align-items: center; gap: 8px; padding: 7px 12px; cursor: pointer; color: #1f2937; border-bottom: 0; border-radius: 5px; }
      .fm-ctx .fm-ctx-item:hover { background: #f3f6fb; }
      .fm-ctx .fm-ctx-item.danger { color: #dc2626; }
      .fm-ctx .fm-ctx-item.danger:hover { background: #fef2f2; }
      .fm-ctx .fm-ctx-hr { height: 1px; background: #f0f1f4; margin: 3px 6px; }
      .fm-ctx .fm-ctx-icon { width: 14px; height: 14px; flex-shrink: 0; opacity: .7; }
      /* 工具栏：无边框幽灵按钮 */
      .fe-toolbar { display: flex; align-items: center; gap: 2px; flex-wrap: wrap; padding: 8px 14px; border: 0; border-bottom: 1px solid #f0f1f4; background: #fff; }
      .fe-tbtn { border: 1px solid transparent; background: transparent; color: #4b5563; border-radius: 6px; padding: 4px 10px; font-size: 12px; cursor: pointer; line-height: 1.5; white-space: nowrap; transition: background .12s; }
      .fe-tbtn:hover:not(:disabled) { background: #f3f4f6; color: #111827; }
      .fe-tbtn:disabled { opacity: .35; cursor: default; }
      .fe-tbtn.on { background: #eef2ff; color: #4f46e5; border-color: #c7d2fe; }
      .fe-sep { width: 1px; height: 16px; background: #e5e7eb; margin: 0 6px; }
      .fe-lang { margin-left: auto; font-size: 11px; color: #6b7280; font-family: 'Cascadia Code', Consolas, monospace; background: #f3f4f6; border-radius: 4px; padding: 2px 8px; }
      .fe-findbar { display: none; align-items: center; gap: 6px; flex-wrap: wrap; padding: 8px 14px; border: 0; border-bottom: 1px solid #f0f1f4; background: #fffbeb; }
      .fe-findbar.is-open { display: flex; }
      .fe-findbar input { padding: 5px 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 12px; font-family: 'Cascadia Code', Consolas, monospace; width: 170px; background: #fff; }
      .fe-findbar input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 2px rgba(99,102,241,.15); }
      .fe-findbar .fe-count { font-size: 12px; color: #6b7280; min-width: 70px; }
      .fe-statusbar { display: flex; align-items: center; gap: 16px; padding: 6px 14px; border: 0; border-top: 1px solid #f0f1f4; background: #fafbfc; font-size: 12px; color: #6b7280; }
      .fe-statusbar .fe-right { margin-left: auto; }
      .fe-statusbar .fe-loc { font-family: 'Cascadia Code', Consolas, monospace; font-size: 11px; color: #9ca3af; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .fe-dirty { color: #d97706; font-weight: 600; visibility: hidden; }
      .fe-dirty.on { visibility: visible; }
      /* —— 宝塔式编辑器布局 —— */
      .fe-mask { padding: 24px; }
      .fe-mask.is-max { padding: 0; }
      .fe-mask.is-max .fm-modal.fe-window { border-radius: 0; }
      .fe-mask .fm-modal.fe-window { width: 100%; max-width: none; max-height: 100%; height: 100%; display: flex; flex-direction: column; position: relative; }
      /* 标题栏窗口按钮（最小化/最大化/关闭） */
      .fe-winbtns { display: flex; align-items: center; gap: 4px; }
      .fe-head-save { padding: 5px 14px; font-size: 12px; margin-right: 10px; }
      .fe-head-save:disabled { opacity: .5; cursor: default; }
      .fe-winbtn { width: 28px; height: 26px; border: 0; background: none; color: #6b7280; font-size: 14px; line-height: 1; cursor: pointer; border-radius: 6px; padding: 0; }
      .fe-winbtn:hover { background: #eef2f7; color: #111827; }
      .fm-modal.dark .fe-winbtn { color: #9d9d9d; }
      .fm-modal.dark .fe-winbtn:hover { background: #3e3e42; color: #fff; }
      /* 最小化恢复条 */
      .fe-mini { position: fixed; right: 20px; bottom: 20px; z-index: 100002; display: none; align-items: center; gap: 8px; background: #1f2937; color: #e5e7eb; border-radius: 999px; padding: 8px 8px 8px 14px; font-size: 12px; box-shadow: 0 8px 28px rgba(15,23,42,.35); cursor: pointer; user-select: none; }
      .fe-mini.show { display: flex; }
      .fe-mini:hover { background: #374151; }
      .fe-mini .fe-mini-ico { font-size: 14px; }
      .fe-mini .fe-mini-txt { max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .fe-mini .fe-mini-x { width: 22px; height: 22px; border: 0; border-radius: 50%; background: rgba(255,255,255,.12); color: #e5e7eb; font-size: 13px; line-height: 1; cursor: pointer; padding: 0; }
      .fe-mini .fe-mini-x:hover { background: #dc2626; color: #fff; }
      /* 注意：.fe-body 同时带 .fm-modal-body（声明了 flex-direction:column），
         display:flex 不会重置方向，必须显式 row，否则侧栏按内容撑高、编辑区被压成 0 高 */
      .fe-body { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0; padding: 0; gap: 0; align-items: stretch; overflow: hidden; }
      .fe-side { flex: 0 0 220px; width: 220px; height: 100%; min-height: 0; overflow: hidden; border-right: 2px solid #d5dbe4; display: flex; flex-direction: column; background: #eef1f6; }
      /* 窄屏：侧栏收窄但始终保留（绝不折叠成 0） */
      @media (max-width: 720px) { .fe-side { flex-basis: 170px; width: 170px; } }
      .fe-side-head { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 1px solid #d5dbe4; font-size: 12px; color: #374151; background: #e3e8f0; font-weight: 600; }
      .fe-side-dir { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'Cascadia Code', Consolas, monospace; font-size: 11px; }
      .fe-side-up, .fe-side-refresh { cursor: pointer; user-select: none; opacity: .7; }
      .fe-side-up:hover, .fe-side-refresh:hover { opacity: 1; }
      .fe-side-list { flex: 1 1 0; min-height: 0; overflow: auto; padding: 4px 0; }
      .fe-side-item { display: flex; align-items: center; gap: 6px; padding: 5px 10px; font-size: 12px; color: #374151; cursor: pointer; user-select: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .fe-side-item:hover { background: #eef2f7; }
      .fe-side-item.is-dir { color: #4f46e5; }
      .fe-side-item.is-active { background: #e0e7ff; color: #3730a3; font-weight: 600; }
      .fe-side-item.is-protected { color: #9ca3af; cursor: default; }
      .fe-side-empty { padding: 16px 10px; color: #9ca3af; font-size: 12px; text-align: center; }
      .fe-main { flex: 1 1 0; height: 100%; min-width: 0; min-height: 0; display: flex; flex-direction: column; }
      .fe-main .fm-editor-wrap { flex: 1 1 0; min-height: 0; }
      .fe-main .fm-cm-host { height: 100%; min-height: 0; }
      /* 标签页 */
      .fe-tabs { display: flex; align-items: center; gap: 2px; padding: 0 10px; border-bottom: 1px solid #f0f1f4; background: #fafbfc; overflow-x: auto; min-height: 34px; }
      .fe-tab { display: flex; align-items: center; gap: 6px; padding: 5px 10px; font-size: 12px; color: #6b7280; cursor: pointer; border: 1px solid transparent; border-bottom: 0; border-radius: 6px 6px 0 0; white-space: nowrap; user-select: none; }
      .fe-tab:hover { background: #f3f4f6; }
      .fe-tab.is-active { background: #fff; color: #111827; border-color: #f0f1f4; font-weight: 600; position: relative; top: 1px; }
      .fe-tab .fe-tab-dot { color: #d97706; font-size: 10px; visibility: hidden; }
      .fe-tab.is-dirty .fe-tab-dot { visibility: visible; }
      .fe-tab .fe-tab-x { border: 0; background: none; cursor: pointer; color: #9ca3af; font-size: 12px; line-height: 1; padding: 0 2px; border-radius: 3px; }
      .fe-tab .fe-tab-x:hover { background: #e5e7eb; color: #374151; }
      /* 快捷键浮层 */
      .fe-keys-pop { position: absolute; top: 44px; right: 14px; z-index: 5; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 8px 24px rgba(15,23,42,.12); padding: 12px 14px; display: none; min-width: 240px; }
      .fe-keys-pop.is-open { display: block; }
      .fe-keys-title { font-size: 12px; font-weight: 600; color: #111827; margin-bottom: 8px; }
      .fe-keys-grid { display: grid; grid-template-columns: auto 1fr; gap: 5px 14px; font-size: 12px; color: #4b5563; }
      .fe-keys-grid span:nth-child(odd) { font-family: 'Cascadia Code', Consolas, monospace; background: #f3f4f6; border-radius: 4px; padding: 1px 6px; }
      /* 深色：编辑器窗口整体 */
      .fm-modal.dark .fe-side { background: #252526; border-right-color: #3e3e42; }
      .fm-modal.dark .fe-side-head { border-bottom-color: #3e3e42; color: #d4d4d4; background: #2d2d2d; }
      .fm-modal.dark .fe-side-item { color: #cccccc; }
      .fm-modal.dark .fe-side-item:hover { background: #2d2d2d; }
      .fm-modal.dark .fe-side-item.is-dir { color: #569cd6; }
      .fm-modal.dark .fe-side-item.is-active { background: #264f78; color: #fff; }
      .fm-modal.dark .fe-side-item.is-protected { color: #6b6b6b; }
      .fm-modal.dark .fe-tabs { background: #2d2d2d; border-bottom-color: #3e3e42; }
      .fm-modal.dark .fe-tab { color: #9d9d9d; }
      .fm-modal.dark .fe-tab:hover { background: #37373d; }
      .fm-modal.dark .fe-tab.is-active { background: #1e1e1e; color: #e7e7e7; border-color: #3e3e42; }
      .fm-modal.dark .fe-tab .fe-tab-x { color: #6b6b6b; }
      .fm-modal.dark .fe-tab .fe-tab-x:hover { background: #4a4a4a; color: #fff; }
      .fm-modal.dark .fe-keys-pop { background: #252526; border-color: #3e3e42; }
      .fm-modal.dark .fe-keys-title { color: #e7e7e7; }
      .fm-modal.dark .fe-keys-grid { color: #cccccc; }
      .fm-modal.dark .fe-keys-grid span:nth-child(odd) { background: #3c3c3c; }
      .fm-modal.dark .fe-statusbar .fe-loc { color: #6b6b6b; }
      .fm-dirs { list-style: none; margin: 0; padding: 0; max-height: 46vh; overflow: auto; border: 1px solid #dcdcdd; border-radius: 3px; }
      .fm-dirs li { padding: 6px 12px; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 6px; }
      .fm-dirs li:hover { background: #f0f6fb; }
      .fm-dirs li.sel { background: #e5f1f8; font-weight: 600; }
      .fm-dirs .fm-dirs-empty { color: #646970; cursor: default; }
      .fm-dest-input { width: 100%; margin-top: 8px; padding: 6px 9px; border: 1px solid #8c8f94; border-radius: 3px; font-size: 13px; font-family: ui-monospace, Consolas, monospace; }
      .fm-modal-hint { font-size: 12px; color: #646970; margin: 8px 0 0; }
    </style>

    <div class="fm-wrap">
      <div class="fm-card">
        <h1>文件管理</h1>
        <div class="fm-muted">管理站点根目录下的文件。<code>.git</code> / <code>node_modules</code> / <code>.astro</code> 为受保护目录，仅可浏览，禁止修改。</div>

        <div class="fm-toolbar">
          <button class="fm-btn" id="btnMkdir">新建文件夹</button>
          <button class="fm-btn" id="btnNewFile">新建文件</button>
          <button class="fm-btn" id="btnUpload">上传</button>
          <button class="fm-btn" id="btnView" disabled>查看</button>
          <button class="fm-btn" id="btnEdit" disabled>编辑</button>
          <button class="fm-btn" id="btnDownload" disabled>下载</button>
          <button class="fm-btn" id="btnCopy" disabled>复制到…</button>
          <button class="fm-btn" id="btnMove" disabled>移动到…</button>
          <button class="fm-btn" id="btnZip" disabled>打包 ZIP</button>
          <button class="fm-btn" id="btnUnzip" disabled>解压</button>
          <button class="fm-btn" id="btnRename" disabled>重命名</button>
          <button class="fm-btn danger" id="btnDelete" disabled>删除</button>
          <button class="fm-btn" id="btnRefresh">刷新</button>
          <input type="file" id="uploadInput" style="display:none" />
        </div>

        <div class="fm-crumbs" id="crumbs"></div>

        <table class="fm-grid">
          <thead>
            <tr>
              <th style="width:32px;"><input type="checkbox" id="checkAll" /></th>
              <th>名称</th>
              <th style="width:110px;">大小</th>
              <th style="width:170px;">修改时间</th>
            </tr>
          </thead>
          <tbody id="fmTbody">
            <tr><td colspan="4" class="fm-empty">加载中…</td></tr>
          </tbody>
        </table>
        <div class="fm-msg fm-muted" id="fmMsg"></div>
      </div>
    </div>

    <!-- 右键菜单（宝塔风格） -->
    <div class="fm-ctx" id="fmCtx" role="menu">
      <div class="fm-ctx-item" data-act="open">打开</div>
      <div class="fm-ctx-item" data-act="edit">编辑</div>
      <div class="fm-ctx-item" data-act="download">下载</div>
      <div class="fm-ctx-hr"></div>
      <div class="fm-ctx-item" data-act="copy">复制到…</div>
