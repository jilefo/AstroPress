---
/**
 * /admin-ext/gist-sync — Gist 云端同步
 *
 * 设置区：GitHub Token（掩码回显，空值不覆盖）/ Gist ID / 文件名 / 描述。
 * 操作区：推送到 Gist、从 Gist 恢复（merge）、查看同步历史（最近 20 条）。
 * 所有写操作带 confirm:true；动态内容一律 textContent，不拼 innerHTML。
 */
import AdminLayout from "../../../../apps/admin/src/layouts/AdminLayout.astro";
if (!Astro.locals.user || !Astro.locals.db) return Astro.redirect("/login");
---
<AdminLayout title="Gist 同步">
    <style is:global>
      * { box-sizing: border-box; }
      .wrap { max-width: 820px; margin: 0 auto; padding: 0 16px; display: grid; gap: 20px; }
      .card { background: #fff; border: 1px solid #c3c4c7; border-radius: 4px; padding: 20px; }
      h1 { font-size: 20px; margin: 0 0 6px; }
      h2 { font-size: 15px; margin: 0 0 12px; }
      .row { margin: 12px 0; font-size: 13px; }
      .row label { display: block; font-weight: 600; margin-bottom: 4px; }
      .row input[type="text"], .row input[type="password"] { width: 100%; padding: 6px 8px; border: 1px solid #8c8f94; border-radius: 3px; font-size: 13px; }
      button { background: #2271b1; color: #fff; border: 0; border-radius: 3px; padding: 8px 18px; cursor: pointer; font-size: 13px; }
      button:hover { background: #135e96; }
      button:disabled { background: #a7aaad; cursor: default; }
      button.danger { background: #b32d2e; }
      button.danger:hover { background: #8a2425; }
      .msg { font-size: 13px; margin-top: 10px; min-height: 18px; }
      .ok { color: #00a32a; }
      .err { color: #b32d2e; }
      .hint { font-size: 12px; color: #646970; margin-top: 6px; line-height: 1.7; }
      code { background: #f0f0f1; padding: 1px 5px; border-radius: 3px; font-size: 12px; }
      .actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 10px 0; }
      .last { background: #f6f7f9; border: 1px solid #e2e4e7; border-radius: 6px; padding: 12px; font-size: 13px; margin: 12px 0; }
      .last b { display: inline-block; min-width: 72px; color: #646970; font-weight: 600; }
      .result { font-size: 12px; background: #f6f7f9; border: 1px solid #e2e4e7; border-radius: 4px; padding: 10px 12px; margin-top: 12px; white-space: pre-wrap; word-break: break-all; max-height: 260px; overflow: auto; }
      table.hist { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 12px; }
      table.hist th, table.hist td { border: 1px solid #e2e4e7; padding: 6px 8px; text-align: left; vertical-align: top; }
      table.hist th { background: #f6f7f9; }
      .badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 11px; }
      .badge.push { background: #e5f2e7; color: #00a32a; }
      .badge.pull { background: #e7f0fa; color: #2271b1; }
      .badge.fail { background: #fef0f0; color: #b32d2e; }
    </style>

    <div class="wrap">
      <!-- 设置 -->
      <section class="card">
        <h1>Gist 同步</h1>
        <p class="hint">把站点配置（站点设置 / 插件设置 / 主题配置 / 内容数据）同步到 GitHub Gist 做云端备份与恢复。导出结构与「配置导入导出」一致，且同样剥离 secret/key/password/salt 等敏感键；Gist 默认创建为私密。</p>
        <div class="row">
          <label for="f-token">GitHub Personal Access Token（需勾选 gist 权限）</label>
          <input type="password" id="f-token" autocomplete="off" />
          <div class="hint" id="tokenHint">未保存 Token</div>
        </div>
        <div class="row">
          <label for="f-gistid">Gist ID（留空则首次推送时自动创建私密 Gist）</label>
          <input type="text" id="f-gistid" autocomplete="off" />
        </div>
        <div class="row">
          <label for="f-filename">Gist 文件名</label>
          <input type="text" id="f-filename" autocomplete="off" />
        </div>
        <div class="row">
          <label for="f-desc">Gist 描述</label>
          <input type="text" id="f-desc" autocomplete="off" />
        </div>
        <button id="saveBtn">保存设置</button>
        <div class="msg" id="setMsg"></div>
      </section>

      <!-- 操作 -->
      <section class="card">
        <h2>同步操作</h2>
        <div class="actions">
          <button id="pushBtn">推送到 Gist</button>
          <button id="pullBtn" class="danger">从 Gist 恢复</button>
          <button id="histBtn" style="background:#50575e">查看同步历史</button>
        </div>
        <div class="hint">恢复采用 merge 模式（按主键 upsert，不删除缺失项），危险操作请在恢复前先用「备份」插件留底。</div>
        <div class="msg" id="opMsg"></div>
        <div class="result" id="opResult" hidden></div>

        <div class="last" id="lastBox" hidden>
          <div><b>最近同步</b><span id="lastTime">—</span></div>
          <div><b>方向</b><span id="lastDir">—</span></div>
          <div><b>结果</b><span id="lastMsg">—</span></div>
        </div>

        <table class="hist" id="histTable" hidden>
          <thead>
            <tr><th>时间</th><th>方向</th><th>结果</th><th>说明</th></tr>
          </thead>
          <tbody id="histBody"></tbody>
        </table>
      </section>
    </div>

    <script>
      var TOKEN_MASKED = "****";

      function setMsg(el, text, ok) {
        el.textContent = text;
        el.className = "msg " + (ok ? "ok" : "err");
      }

      async function api(path, options) {
        var r = await fetch(path, Object.assign({ credentials: "same-origin" }, options || {}));
        var d = null;
        try { d = await r.json(); } catch (e) { d = null; }
        return { status: r.status, ok: r.ok, data: d };
      }

      // ── 设置加载 / 保存 ──
      async function loadSettings() {
        var r = await api("/admin-ext/api/gist-sync/settings");
        if (!r.ok || !r.data || !r.data.settings) return;
        var s = r.data.settings;
        document.getElementById("f-token").value = "";
        document.getElementById("f-gistid").value = s.gistId || "";
        document.getElementById("f-filename").value = s.filename || "";
        document.getElementById("f-desc").value = s.description || "";
        var hint = document.getElementById("tokenHint");
        hint.textContent = s.hasToken
          ? "已保存 Token（" + TOKEN_MASKED + "），留空则不修改；输入新值后保存即覆盖"
          : "未保存 Token，推送/恢复前请先填写";
      }

      document.getElementById("saveBtn").addEventListener("click", async function () {
        var msg = document.getElementById("setMsg");
        var payload = {
          gistId: document.getElementById("f-gistid").value,
          filename: document.getElementById("f-filename").value,
          description: document.getElementById("f-desc").value
        };
        var token = document.getElementById("f-token").value;
        if (token) payload.token = token; // 空值不上送，服务端保持原 token
        var btn = document.getElementById("saveBtn");
        btn.disabled = true;
        try {
          var r = await api("/admin-ext/api/gist-sync/settings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          if (!r.ok) { setMsg(msg, (r.data && r.data.error) || "保存失败", false); return; }
          setMsg(msg, "设置已保存", true);
          loadSettings();
        } catch (e) {
          setMsg(msg, "请求失败：" + e, false);
        } finally {
          btn.disabled = false;
        }
      });

      // ── 推送 / 恢复 ──
      function showResult(obj) {
        var box = document.getElementById("opResult");
        box.textContent = JSON.stringify(obj, null, 2); // 配置 JSON 一律 textContent 显示
        box.hidden = false;
      }

      async function runOp(btnId, path, doing) {
        var btn = document.getElementById(btnId);
        var msg = document.getElementById("opMsg");
        btn.disabled = true;
        var oldText = btn.textContent;
        btn.textContent = doing;
        try {
          var r = await api(path, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ confirm: true })
          });
          if (!r.ok) {
            setMsg(msg, (r.data && r.data.error) || "操作失败", false);
            if (r.data) showResult(r.data);
            return;
          }
          setMsg(msg, btnId === "pushBtn" ? "推送成功" : "恢复完成", true);
          showResult(r.data);
          loadSettings();
        } catch (e) {
          setMsg(msg, "请求失败：" + e, false);
        } finally {
          btn.disabled = false;
          btn.textContent = oldText;
        }
      }

      document.getElementById("pushBtn").addEventListener("click", function () {
        if (!window.confirm("将把当前站点配置推送到 Gist（敏感键已剥离）。确认推送？")) return;
        runOp("pushBtn", "/admin-ext/api/gist-sync/push", "推送中…");
      });
      document.getElementById("pullBtn").addEventListener("click", function () {
        if (!window.confirm("将从 Gist 拉取配置并以 merge 模式写入数据库。确认恢复？")) return;
        runOp("pullBtn", "/admin-ext/api/gist-sync/pull", "恢复中…");
      });

      // ── 历史 ──
      function cellText(tr, text) {
        var td = document.createElement("td");
        td.textContent = text;
        tr.appendChild(td);
        return td;
      }

      function renderHistory(list) {
        var table = document.getElementById("histTable");
        var body = document.getElementById("histBody");
        var lastBox = document.getElementById("lastBox");
        body.textContent = "";
        if (!list.length) {
          table.hidden = true;
          lastBox.hidden = true;
          return;
        }
        var latest = list[0];
        document.getElementById("lastTime").textContent = new Date(latest.time).toLocaleString();
        document.getElementById("lastDir").textContent = latest.direction === "push" ? "推送" : "恢复";
        document.getElementById("lastMsg").textContent = (latest.ok ? "成功：" : "失败：") + latest.message;
        lastBox.hidden = false;

        for (var i = 0; i < list.length; i++) {
          var e = list[i];
          var tr = document.createElement("tr");
          cellText(tr, new Date(e.time).toLocaleString());
          var dirTd = document.createElement("td");
          var badge = document.createElement("span");
          badge.className = "badge " + (e.ok ? e.direction : "fail");
          badge.textContent = e.direction === "push" ? "推送" : "恢复";
          dirTd.appendChild(badge);
          tr.appendChild(dirTd);
          cellText(tr, e.ok ? "成功" : "失败");
          cellText(tr, e.message);
          body.appendChild(tr);
        }
        table.hidden = false;
      }

      document.getElementById("histBtn").addEventListener("click", async function () {
        var msg = document.getElementById("opMsg");
        msg.textContent = "";
        try {
          var r = await api("/admin-ext/api/gist-sync/history");
          if (!r.ok) { setMsg(msg, (r.data && r.data.error) || "读取历史失败", false); return; }
          renderHistory((r.data && r.data.history) || []);
        } catch (e) {
          setMsg(msg, "请求失败：" + e, false);
        }
      });

      // 首屏：载入设置 + 最近一条历史
      loadSettings();
      (async function () {
        var r = await api("/admin-ext/api/gist-sync/history");
        if (r.ok && r.data && r.data.history && r.data.history.length) {
          var latest = r.data.history[0];
          document.getElementById("lastTime").textContent = new Date(latest.time).toLocaleString();
          document.getElementById("lastDir").textContent = latest.direction === "push" ? "推送" : "恢复";
          document.getElementById("lastMsg").textContent = (latest.ok ? "成功：" : "失败：") + latest.message;
          document.getElementById("lastBox").hidden = false;
        }
      })();
    </script>
</AdminLayout>
