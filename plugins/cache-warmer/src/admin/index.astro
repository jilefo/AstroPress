---
/**
 * /admin-ext/cache-warmer — 缓存预热设置与批次记录页
 */
import AdminLayout from "../../../../apps/admin/src/layouts/AdminLayout.astro";
if (!Astro.locals.user || !Astro.locals.db) return Astro.redirect("/login");
---
<AdminLayout title="缓存预热">
    <style is:global>
      * { box-sizing: border-box; }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 16px; }
      .card { background: #fff; border: 1px solid #c3c4c7; border-radius: 4px; padding: 20px; margin-bottom: 20px; }
      h1 { font-size: 20px; margin: 0 0 16px; }
      h2 { font-size: 15px; margin: 0 0 12px; }
      label { display: block; font-size: 13px; font-weight: 600; margin: 16px 0 4px; }
      input[type="text"], input[type="number"], select { font-size: 13px; padding: 6px 8px; border: 1px solid #8c8f94; border-radius: 3px; }
      input[type="text"] { width: 320px; max-width: 100%; }
      input[type="number"] { width: 140px; }
      button { background: #2271b1; color: #fff; border: 0; border-radius: 3px; padding: 8px 16px; cursor: pointer; font-size: 13px; }
      button:hover { background: #135e96; }
      button:disabled { background: #a7aaad; cursor: not-allowed; }
      .btn-secondary { background: #f6f7f7; color: #2c3338; border: 1px solid #c3c4c7; }
      .btn-secondary:hover { background: #eceeef; }
      .btn-secondary:disabled { background: #f6f7f7; color: #a7aaad; }
      .msg { font-size: 13px; margin-top: 10px; min-height: 18px; }
      .ok { color: #00a32a; }
      .err { color: #b32d2e; }
      .hint { font-size: 12px; color: #646970; margin-top: 4px; }
      .check { display: flex; align-items: center; gap: 6px; font-size: 13px; margin-top: 16px; }
      .check label { margin: 0; font-weight: 400; }
      .run-row { display: flex; align-items: center; gap: 12px; }
      .run-state { font-size: 13px; color: #646970; }
      .run-state.on { color: #b32d2e; font-weight: 600; }
      table { width: 100%; border-collapse: collapse; font-size: 13px; }
      th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
      th { background: #f6f7f7; font-weight: 600; white-space: nowrap; }
      td.col-time { white-space: nowrap; color: #646970; }
      td.col-num { text-align: right; white-space: nowrap; }
      .empty { padding: 24px; text-align: center; color: #646970; font-size: 13px; }
    </style>

    <div class="wrap">
      <div class="card">
        <h1>缓存预热</h1>

        <label for="baseUrl">站点基址</label>
        <input type="text" id="baseUrl" placeholder="http://localhost:4321" />
        <div class="hint">预热请求发向该地址（含协议、不带结尾斜杠）。</div>

        <label for="urlCount">每批 URL 数量</label>
        <input type="number" id="urlCount" min="1" max="200" value="50" />
        <div class="hint">首页 + sitemap.xml 前 N 个 URL；范围 1～200（默认 50）。</div>

        <label for="intervalHours">定时预热</label>
        <select id="intervalHours">
          <option value="0">关闭</option>
          <option value="1">每 1 小时</option>
          <option value="6">每 6 小时</option>
          <option value="24">每 24 小时</option>
        </select>
        <div class="hint">进程内定时器，站点进程重启后随首个后台请求自动恢复。</div>

        <div class="check">
          <input type="checkbox" id="enabled" checked />
          <label for="enabled">启用定时预热（手动预热不受影响）</label>
        </div>

        <div style="margin-top:16px">
          <button id="save">保存设置</button>
        </div>
        <div class="msg" id="msg"></div>
      </div>

      <div class="card">
        <h2>手动预热</h2>
        <div class="run-row">
          <button type="button" id="runBtn">立即预热</button>
          <span class="run-state" id="runState">空闲</span>
        </div>
        <div class="hint">串行抓取、间隔 300ms、单请求超时 10s；同一时间仅允许一批运行。</div>
      </div>

      <div class="card">
        <h2>批次记录（最近 10 批）</h2>
        <table>
          <thead>
            <tr>
              <th>时间</th>
              <th>触发</th>
              <th style="text-align:right">总数</th>
              <th style="text-align:right">成功</th>
              <th style="text-align:right">失败</th>
              <th style="text-align:right">耗时</th>
            </tr>
          </thead>
          <tbody id="batchBody"></tbody>
        </table>
        <div class="empty" id="emptyTip" style="display:none">暂无批次记录</div>
      </div>
    </div>

    <script>
      (function () {
        var msg = document.getElementById("msg");
        var runBtn = document.getElementById("runBtn");
        var runState = document.getElementById("runState");
        var bodyEl = document.getElementById("batchBody");
        var emptyEl = document.getElementById("emptyTip");

        function flash(text, ok) {
          msg.className = "msg " + (ok ? "ok" : "err");
          msg.textContent = text;
          setTimeout(function () { msg.textContent = ""; }, 3000);
        }

        function cell(tr, text, cls) {
          var td = document.createElement("td");
          td.textContent = text;
          if (cls) td.setAttribute("class", cls);
          tr.appendChild(td);
          return td;
        }

        function fmtTime(ts) {
          var n = Number(ts);
          if (!Number.isFinite(n) || n <= 0) return "—";
          return new Date(n).toLocaleString();
        }

        function fmtDuration(ms) {
          var n = Number(ms) || 0;
          if (n < 1000) return n + " ms";
          return (n / 1000).toFixed(1) + " s";
        }

        function renderRecords(records) {
          while (bodyEl.firstChild) bodyEl.removeChild(bodyEl.firstChild);
          if (!records || records.length === 0) {
            emptyEl.style.display = "block";
            return;
          }
          emptyEl.style.display = "none";
          records.forEach(function (r) {
            var tr = document.createElement("tr");
            cell(tr, fmtTime(r.at), "col-time");
            cell(tr, r.trigger === "schedule" ? "定时" : "手动", "");
            cell(tr, String(r.total ?? 0), "col-num");
            cell(tr, String(r.ok ?? 0), "col-num");
            cell(tr, String(r.fail ?? 0), "col-num");
            cell(tr, fmtDuration(r.durationMs), "col-num");
            bodyEl.appendChild(tr);
          });
        }

        function refreshStatus() {
          return fetch("/admin-ext/api/cache-warmer/status")
            .then(function (r) { return r.json(); })
            .then(function (d) {
              var running = !!(d && d.running);
              runBtn.disabled = running;
              runState.textContent = running ? "预热运行中…" : "空闲";
              runState.className = "run-state" + (running ? " on" : "");
              renderRecords(d && d.records);
            })
            .catch(function () { /* 轮询失败静默 */ });
        }

        function loadSettings() {
          fetch("/admin-ext/api/cache-warmer/settings")
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (s) {
              if (!s) return;
              document.getElementById("baseUrl").value = String(s.baseUrl || "");
              document.getElementById("urlCount").value = String(s.urlCount ?? 50);
              document.getElementById("intervalHours").value = String(s.intervalHours ?? 0);
              document.getElementById("enabled").checked = !!s.enabled;
            });
        }

        document.getElementById("save").addEventListener("click", function () {
          var payload = {
            baseUrl: document.getElementById("baseUrl").value.trim(),
            urlCount: parseInt(document.getElementById("urlCount").value, 10),
            intervalHours: parseInt(document.getElementById("intervalHours").value, 10),
            enabled: document.getElementById("enabled").checked,
          };
          fetch("/admin-ext/api/cache-warmer/settings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          })
            .then(function (r) {
              return r.json().catch(function () { return {}; }).then(function (d) {
                return { ok: r.ok, data: d };
              });
            })
            .then(function (res) {
              if (res.ok && res.data && res.data.settings) {
                flash("已保存。", true);
                document.getElementById("baseUrl").value = String(res.data.settings.baseUrl || "");
                document.getElementById("urlCount").value = String(res.data.settings.urlCount);
              } else {
                flash((res.data && res.data.error) || "保存失败", false);
              }
            })
            .catch(function () { flash("保存失败", false); });
        });

        runBtn.addEventListener("click", function () {
          runBtn.disabled = true;
          fetch("/admin-ext/api/cache-warmer/run", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({}),
          })
            .then(function (r) {
              return r.json().catch(function () { return {}; }).then(function (d) {
                if (r.ok || r.status === 202) {
                  flash("预热已开始，正在后台抓取页面。", true);
                } else if (r.status === 409) {
                  flash("已有预热任务运行中。", false);
                } else {
                  flash((d && d.error) || "触发失败", false);
                }
              });
            })
            .catch(function () { flash("触发失败", false); })
            .then(function () { refreshStatus(); });
        });

        loadSettings();
        refreshStatus();
        // 每 3 秒轮询运行状态与批次记录
        setInterval(refreshStatus, 3000);
      })();
    </script>
</AdminLayout>
