---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listPosts } from "../../../lib/posts";

const db = Astro.locals.db;
if (!Astro.locals.user || !db) return Astro.redirect("/login");

const status = Astro.url.searchParams.get("status") ?? undefined;
const page = Number(Astro.url.searchParams.get("page") ?? "1");

const { posts, total } = await listPosts(db, { type: "post", status, page });

const perPage = 20;
const totalPages = Math.ceil(total / perPage);
const isTrash = status === "trash";

const statusOptions = [
  { value: "", label: "全部" },
  { value: "publish", label: "已发布" },
  { value: "draft", label: "草稿" },
  { value: "trash", label: "回收站" },
];
---
<AdminLayout title="文章">

  <h1 class="wp-heading-inline">文章</h1>
  <a href="/admin/posts/new" class="page-title-action">新建</a>
  <hr class="wp-header-end" />

  <ul class="subsubsub">
    {statusOptions.map((s) => (
      <li>
        <a
          href={s.value ? `/admin/posts?status=${s.value}` : "/admin/posts"}
          class={(status ?? "") === s.value ? "current" : ""}
        >
          {s.label}
        </a>
      </li>
    ))}
  </ul>

  {posts.length === 0 ? (
    <div class="ap-empty-state">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" style="color:#8c8f94;margin-bottom:12px">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
        <polyline points="10 9 9 9 8 9"/>
      </svg>
      <h2 style="font-size:15px;font-weight:600;color:#1d2327;margin:0 0 8px">还没有文章</h2>
      <p style="font-size:13px;color:#646970;margin:0 0 20px;line-height:1.5">
        {status ? `没有状态为“${status}”的文章。` : "写下你的第一篇文章吧。"}
      </p>
      <a href="/admin/posts/new" class="button button-primary">新建第一篇文章</a>
    </div>
  ) : (
    <form id="bulk-action-form">
      <!-- Top tablenav -->
      <div class="tablenav top">
        <div class="alignleft actions bulkactions">
          <select class="bulk-action-selector" id="bulk-action-selector-top">
            <option value="-1">批量操作</option>
            {isTrash ? (
              <>
                <option value="restore">恢复</option>
                <option value="delete">永久删除</option>
              </>
            ) : (
              <>
                <option value="trash">移入回收站</option>
                <option value="publish">发布</option>
                <option value="draft">转为草稿</option>
              </>
            )}
          </select>
          <button type="button" onclick="applyBulkAction()" class="button action">应用</button>
        </div>
        <div class="tablenav-pages" style="line-height:28px">
          <span class="displaying-num">{total} 项</span>
        </div>
      </div>

      <table class="wp-list-table widefat fixed striped">
        <thead>
          <tr>
            <th scope="col" class="manage-column column-cb check-column" style="width:2.2em">
              <input type="checkbox" id="cb-select-all-1" title="全选" />
            </th>
            <th scope="col" class="manage-column column-primary">标题</th>
            <th scope="col" class="manage-column" style="width:100px">状态</th>
            <th scope="col" class="manage-column" style="width:120px">日期</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr>
              <th scope="row" class="check-column">
                <input type="checkbox" class="cb-select-posts" value={String(post.id)} />
              </th>
              <td class="title column-title has-row-actions column-primary">
                <strong>
                  <a href={`/admin/posts/${post.id}`} class="row-title">
                    {post.title || <em style="font-weight:400;color:#8c8f94">无标题</em>}
                  </a>
                </strong>
                <div class="row-actions">
                  {!isTrash && <span class="edit"><a href={`/admin/posts/${post.id}`}>编辑</a> | </span>}
                  {!isTrash && (
                    <span class="trash">
                      <button onclick={`apBulkSingle('trash',${post.id})`} class="ap-row-delete-btn">移入回收站</button>
                    </span>
                  )}
                  {isTrash && (
                    <>
                      <span class="untrash"><button onclick={`apBulkSingle('restore',${post.id})`} class="ap-row-delete-btn" style="color:#2271b1">恢复</button> | </span>
                      <span class="delete"><button onclick={`apBulkSingle('delete',${post.id})`} class="ap-row-delete-btn">永久删除</button></span>
                    </>
                  )}
                </div>
              </td>
              <td>
                <span style={`display:inline-block;font-size:11px;padding:2px 8px;border-radius:10px;font-weight:600;background:${post.status === "publish" ? "#d1e7dd" : post.status === "trash" ? "#f8d7da" : "#fff3cd"};color:${post.status === "publish" ? "#146c43" : post.status === "trash" ? "#842029" : "#997404"}`}>
                  {post.status === "publish" ? "已发布" : post.status === "draft" ? "草稿" : post.status === "trash" ? "回收站" : post.status === "private" ? "私密" : post.status}
                </span>
              </td>
              <td style="color:var(--wp-gray-600);font-size:12px">{post.date.slice(0, 10)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- Bottom tablenav -->
      <div class="tablenav bottom">
        <div class="alignleft actions bulkactions">
          <select class="bulk-action-selector" id="bulk-action-selector-bottom">
            <option value="-1">批量操作</option>
            {isTrash ? (
              <>
                <option value="restore">恢复</option>
                <option value="delete">永久删除</option>
              </>
            ) : (
              <>
                <option value="trash">移入回收站</option>
                <option value="publish">发布</option>
                <option value="draft">转为草稿</option>
              </>
            )}
          </select>
          <button type="button" onclick="applyBulkAction()" class="button action">应用</button>
        </div>
        {totalPages > 1 && (
          <div class="tablenav-pages">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
              <a
                href={`/admin/posts?page=${p}${status ? `&status=${status}` : ""}`}
                class={p === page ? "button button-disabled" : "button"}
                style={p === page ? "font-weight:700" : ""}
              >
                {p}
              </a>
            ))}
          </div>
        )}
      </div>
    </form>
  )}

</AdminLayout>

<script is:inline>
// Extensible bulk actions registry — plugins can push { value, label, handler } here
window.apBulkActions = window.apBulkActions || [];

(function () {
  // Sync both selectors
  document.querySelectorAll('.bulk-action-selector').forEach(function (sel) {
    sel.addEventListener('change', function () {
      document.querySelectorAll('.bulk-action-selector').forEach(function (s) { s.value = sel.value; });
    });
  });

  // Select all
  var selectAll = document.getElementById('cb-select-all-1');
  if (selectAll) {
    selectAll.addEventListener('change', function () {
      document.querySelectorAll('.cb-select-posts').forEach(function (cb) { cb.checked = selectAll.checked; });
    });
  }
  document.querySelectorAll('.cb-select-posts').forEach(function (cb) {
    cb.addEventListener('change', function () {
      if (selectAll) selectAll.checked = document.querySelectorAll('.cb-select-posts:not(:checked)').length === 0;
    });
  });
})();

window.applyBulkAction = async function () {
  var sel = document.querySelector('.bulk-action-selector');
  var action = sel ? sel.value : '-1';
  if (!action || action === '-1') { alert('请选择一个操作。'); return; }

  var ids = Array.from(document.querySelectorAll('.cb-select-posts:checked')).map(function (cb) { return parseInt(cb.value); });
  if (ids.length === 0) { alert('请至少选择一项。'); return; }

  // Check plugin-registered handlers first
  var custom = (window.apBulkActions || []).find(function (a) { return a.value === action && a.handler; });
  if (custom) { return custom.handler(ids); }

  var confirmMsg = action === 'delete'
    ? '确定永久删除选中的 ' + ids.length + ' 项吗？此操作无法撤销。'
    : '将此操作应用于选中的 ' + ids.length + ' 项吗？';
  if (!confirm(confirmMsg)) return;

  var res = await fetch('/api/posts/bulk', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: action, ids: ids }) });
  if (res.ok) { location.reload(); }
  else { var d = await res.json().catch(function () { return {}; }); alert(d.error || '操作失败。'); }
};

window.apBulkSingle = async function (action, id) {
  var confirmMsg = action === 'delete' ? '确定永久删除此项吗？此操作无法撤销。' : action === 'trash' ? '确定移入回收站吗？' : null;
  if (confirmMsg && !confirm(confirmMsg)) return;
  var res = await fetch('/api/posts/bulk', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: action, ids: [id] }) });
  if (res.ok) { location.reload(); }
  else { var d = await res.json().catch(function () { return {}; }); alert(d.error || '操作失败。'); }
};
</script>
