---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="页面不存在">
  <div class="not-found">
    <h1>404</h1>
    <h2>页面不存在</h2>
    <p style="color:var(--color-muted)">您访问的页面不存在或已被移除。</p>
    <a href="/" style="display:inline-block;margin-top:16px">← 返回首页</a>
  </div>
</BaseLayout>
