{
  "name": "Stillora",
  "version": "1.0.0",
  "description": "Ultra-minimal photography and editorial theme with zero radius",
  "author": "Stillora",
  "tokens": {
    "fonts": {
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "heading": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    },
    "spacing": {
