{
  "name": "Weisay Grace",
  "version": "2.6.0",
  "description": "Two-column responsive blog theme with red-pink accent",
  "author": "Weisay",
  "tokens": {
    "fonts": {
      "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "heading": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
    },
    "spacing": {
