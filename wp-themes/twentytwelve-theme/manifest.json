{
  "name": "Twenty Twelve",
  "version": "3.0.0",
  "description": "Classic WordPress blog theme with Open Sans typography",
  "author": "WordPress Team",
  "tokens": {
    "fonts": {
      "body": "'Open Sans', -apple-system, sans-serif",
